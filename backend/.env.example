# JCB Work Management API — copy to .env for local development.
# In staging/production set these in the host's secret store; never commit .env.

# --- Application -----------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=3000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
# Number of reverse-proxy hops in front of the API (for client IPs/rate limits).
TRUST_PROXY=0
# Swagger UI at /api/docs (default: on except in production).
# API_DOCS_ENABLED=false

# --- PostgreSQL --------------------------------------------------------------
# Use TLS for hosted databases, e.g. ...?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jcb_dev
DATABASE_POOL_MAX=10
# Only for `npm test` (a separate, disposable database).
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jcb_test

# --- Tokens ------------------------------------------------------------------
# At least 32 random characters, different per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=jcb-api
JWT_AUDIENCE=jcb-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS_MOBILE=60
REFRESH_TOKEN_TTL_HOURS_PORTAL=12
REFRESH_REUSE_GRACE_SECONDS=60

# --- Password reset ----------------------------------------------------------
# The admin portal's public reset page (used by app users and admins).
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TTL_MINUTES=60

# --- CORS --------------------------------------------------------------------
# Exact origins of the admin portal, comma-separated. The mobile app needs none.
CORS_ORIGINS=http://localhost:5173

# --- Email (optional; without SMTP_HOST reset links are written to the log) --
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=JCB Works <no-reply@example.com>

# --- File storage --------------------------------------------------------------
# None: photos and PDFs stay on the phones (product decisions #13–14).
